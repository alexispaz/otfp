#!/bin/tclsh

# Run in test mode?
# - true:  Runs a short, functional test for rapid debugging.
# - false: Runs the full example to generate meaningful results.
set test true

# Global variables
set oname           job0
set temperature     298
set seed            923458

# NAMD seed
seed                $seed
 
# System 
structure           ../systems/alad.psf
coordinates         ../systems/alad.pdb

# Potentials and parameters
paraTypeCharmm      on
parameters          ../systems/par_all22_prot.prm
parameters          ../systems/par_all36_prot.prm
exclude             scaled1-4
1-4scaling          1.0

# Non-bonding cutoff
cutoff              10.0  ;#12.0 
switching           on    ;# suavisado
switchdist           9.0  ;#10.0 # Desde donde comienza el suavizado

# Verlet List
pairlistdist        11.5  ;#14.0 #Radio externo de Verlet
stepspercycle       10    ;#Pasos para el calculo de la lista de Verlet


# Multiple time steps
nonbondedFreq       1
fullElectFrequency  2
 
# The motion
firsttimestep       0
timestep            2.0
rigidBonds          all  

# Ensemble NVT
temperature         $temperature
langevin            on;             # do langevin dynamics
langevinTemp        $temperature;   # bath temperature
langevinHydrogen    no
langevinDamping     50.

# Output
outputName          ${oname}
restartfreq         100000
outputEnergies      100000
outputTiming        100000
if $test {
  dcdfreq    1
} else {
  dcdfreq    100000
}

# Call to OTFP config
source OTFP.namd

# Increase Load Balancer period
ldbPeriod 100000

if $test {
  run  5000
} else {
  run  10000000 ;#  1ns
}
