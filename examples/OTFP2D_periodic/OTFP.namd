#!/bin/tclsh

# Set OTFP path
if {![info exists CFACV_BASEDIR]} {set CFACV_BASEDIR $::env(CFACV_BASEDIR)}
tclforcesscript       $CFACV_BASEDIR/include/calcforces.tcl
            
# OTFP use NAMD tclforces system
tclforces             on

# Definition of group/center IDs (1-based) from PDB beta position
set labelPDB          label.pdb

# Control FES recovery 
set FES(dm)                2
set FES(max)              [list [expr acos(-1.)] [expr acos(-1.)]]
set FES(min)              [list [expr -acos(-1.)] [expr -acos(-1.)]] 
set FES(knots)            {151 151}                                  
set FES(start)              10000 ;# Initial steps without accumulate FES statistics
set FES(solve.freq)        500000 ;# Frequency of solving FES
set FES(solve.start)            0 ;# Initial steps without solving FES
set FES(outfile)           ${oname}
set FES(outfreq)           500000
set FES(outlvl)            3


if $test {
  set FES(start)               0
  set FES(solve.freq)       2500
  set FES(outfreq)          2500
}
 
set PERIODIC                {1 1}

# Collective Variables
set cv(num) 1
set cv(1.type)     DIHED
set cv(1.centers)  {1 2 3 4}
set cv(1.outfile)  "phi.x"
set cv(1.outfreq)  1

set cv(num) 2
set cv(2.type)     DIHED
set cv(2.centers)  {2 3 4 5}
set cv(2.outfile)  "psi.x"
set cv(2.outfreq)  1

# Restraints
set restr(num)        2

set restr(1.cv)       1              ; # The cv or cvs associated
set restr(1.chid)     0           
set restr(1.chdm)     0
set restr(1.k)         500           ; # spring constant
set restr(1.type)     tamd           ; # spring constant
 set restr(1.g)        500          
 set restr(1.temp)    5000          ; # number between 0 and beta (min and max bias)
 set restr(1.dt)      0.002         
set restr(1.bound)    periodic
 set restr(1.max)     [expr acos(-1.)]
 set restr(1.min)     [expr -acos(-1.)]
set restr(1.outfile)  "phi.r"
set restr(1.outfreq)  1

set restr(2.cv)       2              ; # The cv or cvs associated
set restr(2.chid)     0           
set restr(2.chdm)     1
set restr(2.k)         500           ; # spring constant
set restr(2.type)     tamd           ; # spring constant
 set restr(2.g)        500          
 set restr(2.temp)    5000          ; # number between 0 and beta (min and max bias)
 set restr(2.dt)      0.002         
set restr(2.bound)    periodic
 set restr(2.max)     [expr acos(-1.)]
 set restr(2.min)     [expr -acos(-1.)]
set restr(2.outfile)  "psi.r"
set restr(2.outfreq)  1
 

# Initialize OTFP program
source $CFACV_BASEDIR/include/cfacv.tcl
 
