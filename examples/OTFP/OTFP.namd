#!/bin/tclsh

# Set OTFP path
if {![info exists CFACV_BASEDIR]} {set CFACV_BASEDIR $::env(CFACV_BASEDIR)}
tclforcesscript       $CFACV_BASEDIR/include/calcforces.tcl
            
# OTFP use NAMD tclforces system
tclforces             on

# Definition of group/center IDs (1-based) from PDB beta position
set labelPDB          label.pdb

# Control FES recovery 

set FES(max)                 4.8
set FES(min)                 2.0
set FES(knots)               201 
set FES(start)              500 ;# Initial steps without accumulate FES statistics
set FES(solve.freq)         500 ;# Frequency of solving FES          
set FES(solve.start)        500 ;# Initial steps without solving FES 
set FES(outfile)     ${oname}
set FES(outfreq)     500
set FES(outlvl)      3

if $test {
  set FES(start)              10
  set FES(solve.freq)        500
  set FES(outfreq)           500
}
 
# Control parametrization solver

# Collective Variables
set cv(num) 1
set cv(1.type)     BOND
 set cv(1.centers)  {1 2}
set cv(1.outfile)  "${oname}.cv"
 set cv(1.outfreq) 500

# Restraints
set restr(num)        1
set restr(1.cv)       1              ; # The cv or cvs associated
set restr(1.k)        1500           ; # spring constant
set restr(1.type)     tamd
 set restr(1.g)       1500
 set restr(1.temp)    3000
 set restr(1.dt)      0.002         
set restr(1.bound)    soft           ; # boundary behavior
 set restr(1.boundk)   100           
 set restr(1.max)      $FES(max)
 set restr(1.min)      $FES(min)
set restr(1.outfile)   "${oname}.r"
set restr(1.outfreq) 500

# Initialize OTFP program
source $CFACV_BASEDIR/include/cfacv.tcl

