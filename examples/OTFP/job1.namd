#!/bin/tclsh

# Run in test mode?
# - true:  Runs a short, functional test for rapid debugging.
# - false: Runs the full example to generate meaningful results.
set test true

# Global variables
set oname           job1
set temperature     298
set seed            1236547
                          
#There is two modes to restart OTFP, chose one:
set restart_otfp cfacv_loadstate
# set restart_chapeau chapeau_loadlambda
             
# NAMD seed
seed                $seed
 
# System 
structure           ../systems/buta.psf
coordinates         ../systems/buta.pdb
binCoordinates      job0.restart.coor

# Potentials and parameters
paraTypeCharmm      on
parameters          ../systems/par_all36_cgenff.prm
exclude             scaled1-4
1-4scaling          1.0

# Non-bonding cutoff
cutoff              11.0  ;#12.0 
switching           on    ;# suavisado
switchdist          10.0  ;#10.0 # Desde donde comienza el suavizado

# Verlet List
pairlistdist        12.0  ;#14.0 #Radio externo de Verlet
stepspercycle       10    ;#Pasos para el calculo de la lista de Verlet


# Multiple time steps
nonbondedFreq       1
fullElectFrequency  2
          
# The motion
if $test {
  firsttimestep       2000
} else {
  firsttimestep       2000000
}
timestep            2.0
rigidBonds          all  

# Ensemble NVT
temperature         $temperature
langevin            on;             # do langevin dynamics
langevinTemp        $temperature;   # bath temperature
langevinHydrogen    no
langevinDamping     50.

# Output
outputName          ${oname}
restartfreq         10000
outputEnergies      5000
outputTiming        10000
if $test {
  dcdfreq    1
} else {
  dcdfreq    5000
}

# Call to OTFP config
source OTFP.namd

# Restart restraints
DataSpace_load_restraints $ds job0.rstr
    
# Restart chapeaus
chapeau_loadstate $chape(0.address) job0.ch0
          
if $test {
  run  2000
} else {
  run  2000000 ;# 4ns
}
