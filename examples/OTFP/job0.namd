#!/bin/tclsh

# Run in test mode?
# - true:  Runs a short, functional test for rapid debugging.
# - false: Runs the full example to generate meaningful results.
set test true

# Global variables
set oname           job0
set temperature     298
set seed            923458

# NAMD seed
seed                $seed
 
# System 
structure           ../systems/buta.psf
coordinates         ../systems/buta.pdb

# Potentials and parameters
paraTypeCharmm      on
parameters          ../systems/par_all36_cgenff.prm
exclude             scaled1-4
1-4scaling          1.0

# Non-bonding cutoff
cutoff              11.0  ;#12.0 
switching           on    ;# suavisado
switchdist          10.0  ;#10.0 # Desde donde comienza el suavizado

# Verlet List
pairlistdist        12.0  ;#14.0 #Radio externo de Verlet
stepspercycle       10    ;#Pasos para el calculo de la lista de Verlet


# Multiple time steps
nonbondedFreq       1
fullElectFrequency  2
 
# The motion
firsttimestep       0
timestep            2.0
rigidBonds          all  

# Ensemble NVT
temperature         $temperature
langevin            on;             # do langevin dynamics
langevinTemp        $temperature;   # bath temperature
langevinHydrogen    no
langevinDamping     50.

# Output
outputName          ${oname}
restartfreq         10000
outputEnergies      5000
outputTiming        5000
if $test {
  dcdfreq    1
} else {
  dcdfreq    5000
}

# Call to OTFP config
source OTFP.namd

if $test {
  run  2000
} else {
  run  2000000 ;# 4ns
}
